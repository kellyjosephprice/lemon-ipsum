<% content_for :title, "Lemon Ipsum" %>

<main id="lemon-ipsum">
  <h1><span>LEMON</span>IPSUM</h1>

  <div id="sentences">
    <% @sentences.each do |paragraph| %>
      <p>
        <% paragraph.each do |sentence| %>
          <%= sentence %>
        <% end %>
      </p>
    <% end %>
  </div>

  <footer>
    <a href="https://github.com/kellyjosephprice/lemon-ipsum">
      source
    </a>
  </footer>
</main>
